// Prisma schema for EduFlow School OS
// Synchronized with lib/db/schema.ts (Drizzle ORM)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  city                String?              @default("Karachi")
  adminEmail          String?              @map("admin_email")
  ownerName           String?              @map("owner_name")
  phone               String?
  planTier            String               @default("pro") @map("plan_tier")
  planStatus          String               @default("trial") @map("plan_status")
  createdAt           DateTime             @default(now()) @map("created_at")
  trialStartsAt       DateTime             @default(now()) @map("trial_starts_at")
  trialEndsAt         DateTime             @map("trial_ends_at")
  firstPaidAt         DateTime?            @map("first_paid_at")
  lastPaidAt          DateTime?            @map("last_paid_at")
  nextBillingDate     DateTime             @map("next_billing_date")
  monthlyAmount       Decimal              @default(5000.00) @map("monthly_amount") @db.Decimal(12, 2)
  schoolSetupComplete Boolean              @default(false) @map("school_setup_complete")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  campuses            Campus[]
  students            Student[]
  teachers            Teacher[]
  attendance          Attendance[]
  feeVouchers         FeeVoucher[]
  profiles            Profile[]
  payments            SubscriptionPayment[]

  @@index([slug])
  @@index([createdAt])
  @@map("schools")
}

model SubscriptionPayment {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("PKR")
  billingCycle  String    @default("monthly") @map("billing_cycle")
  paymentMethod String    @default("bank_transfer") @map("payment_method")
  status        String    @default("paid")
  paidAt        DateTime  @default(now()) @map("paid_at")
  periodStart   DateTime  @map("period_start")
  periodEnd     DateTime  @map("period_end")
  referenceNo   String?   @map("reference_no")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([schoolId])
  @@index([paidAt])
  @@map("subscription_payments")
}

model Campus {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  city      String
  phone     String?
  address   String?
  students  Student[]
  teachers  Teacher[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("campuses")
}

model Profile {
  id                  String   @id
  email               String   @unique
  fullName            String   @map("full_name")
  role                String   @default("school_admin")
  schoolId            String?  @map("school_id")
  school              School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  schoolSetupComplete Boolean  @default(false) @map("school_setup_complete")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([schoolId])
  @@map("profiles")
}

model Student {
  id            String       @id @default(uuid())
  schoolId      String       @map("school_id")
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String?      @map("campus_id")
  campus        Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  fullName      String       @map("full_name")
  rollNumber    String       @map("roll_number")
  grade         String
  section       String
  gender        String?
  guardianName  String?      @map("guardian_name")
  guardianPhone String?      @map("guardian_phone")
  guardianEmail String?      @map("guardian_email")
  parentId      String?      @map("parent_id")
  monthlyFee    Decimal      @default(0.0) @map("monthly_fee") @db.Decimal(12, 2)
  status        String       @default("active")
  attendance    Attendance[]
  feeVouchers   FeeVoucher[]
  createdAt     DateTime     @default(now()) @map("created_at")

  @@unique([schoolId, rollNumber], name: "students_school_roll_uq")
  @@index([schoolId])
  @@index([parentId])
  @@map("students")
}

model Teacher {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String?  @map("campus_id")
  campus         Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  fullName       String   @map("full_name")
  employeeCode   String   @map("employee_code")
  email          String?
  phone          String?
  department     String?
  specialization String?
  monthlySalary  Decimal  @default(0.0) @map("monthly_salary") @db.Decimal(12, 2)
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([schoolId, employeeCode], name: "teachers_school_emp_uq")
  @@index([schoolId])
  @@map("teachers")
}

model Attendance {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  status    String   // present, absent, leave, late
  remarks   String?
  markedAt  DateTime @default(now()) @map("marked_at")

  @@unique([studentId, date], name: "attendance_student_date_uq")
  @@index([schoolId, date])
  @@map("attendance")
}

model FeeVoucher {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String    @map("student_id")
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challanNumber String    @map("challan_number")
  monthYear     String    @map("month_year")
  amount        Decimal   @db.Decimal(12, 2)
  dueDate       String    @map("due_date")
  status        String    @default("unpaid") // unpaid, paid, overdue
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([schoolId, challanNumber], name: "fee_vouchers_school_challan_uq")
  @@index([schoolId, status])
  @@map("fee_vouchers")
}
