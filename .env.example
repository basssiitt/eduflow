# EduFlow OS - Environment Configuration Template
# Instructions:
# 1. Copy this file to '.env.local': cp .env.example .env.local
# 2. Fill in your actual credentials.
# 3. DO NOT commit '.env' or '.env.local' to Git. They are ignored by .gitignore.

# ------------------------------------------------------------------------------
# Supabase Authentication & Database
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-operations

# ------------------------------------------------------------------------------
# PostgreSQL Connection (Drizzle / Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/eduflow

# ------------------------------------------------------------------------------
# Google Gemini AI API (Parent Companion & Assistant)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# Platform Super Admin Configuration
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAILS=admin@yourdomain.com
